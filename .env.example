# Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only secret. Never expose this with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Set to true after Supabase migrations and auth are configured.
# Leave false for local demo/mock mode.
NEXT_PUBLIC_USE_SUPABASE=false

# Created by supabase/migrations/20260430000004_storage_buckets.sql
NEXT_PUBLIC_SUPABASE_AUDIO_BUCKET=recordings

# Optional worker settings
WORKER_USE_SUPABASE=false
STT_ENGINE=mock
OPENAI_API_KEY=

# NAVER Search Open API
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret
NAVER_NCP_CLIENT_ID=your-ncloud-ai-naver-client-id
NAVER_NCP_CLIENT_SECRET=your-ncloud-ai-naver-client-secret

# NAVER Cloud CLOVA Speech long sentence recognition
NAVER_CLOVA_SPEECH_INVOKE_URL=https://clovaspeech-gw.ncloud.com/external/v1/your-invoke-id
NAVER_CLOVA_SPEECH_SECRET=your-clova-speech-secret

# AI answer generation. Use openai or anthropic.
AI_ANSWER_PROVIDER=openai
OPENAI_ANSWER_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_ANSWER_MODEL=claude-3-5-sonnet-latest
