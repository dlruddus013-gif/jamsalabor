# Supabase Postgres 연결 문자열
# Supabase Dashboard → Project Settings → Database → Connection string → "URI"
# Vercel Serverless에서는 반드시 "Connection Pooling (포트 6543)" URL을 사용하세요.
# 예시: postgresql://postgres.<project_ref>:<password>@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
DATABASE_URL=

# (선택) 프론트엔드에서 Supabase JS 클라이언트로 직접 접근할 경우
SUPABASE_URL=
SUPABASE_ANON_KEY=
